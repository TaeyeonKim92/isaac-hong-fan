# Spotify API
# 발급: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=여기에_클라이언트_아이디
SPOTIFY_CLIENT_SECRET=여기에_클라이언트_시크릿

# YouTube Data API v3
# 발급: https://console.cloud.google.com
YOUTUBE_API_KEY=여기에_유튜브_API_키

# KOPIS 공연예술통합전산망 API (선택)
# 발급: https://www.kopis.or.kr
# 없으면 코드에 등록된 수동 공연 목록만 표시됩니다.
KOPIS_API_KEY=여기에_KOPIS_API_키
# 홍이삭이 공연명에 없고 출연진에만 있는 대중음악 공연을 추가로 훑을 페이지 수
KOPIS_CAST_SCAN_PAGES=2
KOPIS_POPULAR_MUSIC_GENRE_CODE=CCCD

# Instagram Graph API
# Meta 앱 + Instagram Business/Creator 계정 연결 필요
INSTAGRAM_ACCESS_TOKEN=여기에_인스타그램_액세스_토큰
INSTAGRAM_BUSINESS_ACCOUNT_ID=여기에_내_인스타그램_비즈니스_계정_ID
INSTAGRAM_GRAPH_API_VERSION=v23.0
